# ──────────────────────────────────────────────
# LeadForge Environment Variables
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# ── Infrastructure ────────────────────────────
DATABASE_URL=postgresql+asyncpg://leadforge:leadforge@localhost:5432/leadforge
REDIS_URL=redis://localhost:6379/0

# ── Chicago Data Portal (Socrata) ─────────────
# Get app token: https://data.cityofchicago.org/profile/edit/developer_settings
SOCRATA_APP_TOKEN=your_socrata_app_token

# ── Google Places API ─────────────────────────
# Enable Places API: https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ── vLLM (Local CPU Inference) ───────────────
# Docker: docker compose up vllm (serves on port 8001)
# Model downloads to vllm-cache Docker volume on first run
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct

# ── LLM Routing (OpenRouter) ─────────────────
# Get API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
OPENROUTER_MODEL_ID=nvidia/nemotron-3-super-120b-a12b:free

# ── Claude (Anthropic Foundry) ────────────────
# For outreach brief generation and sentiment analysis
ANTHROPIC_FOUNDRY_RESOURCE=your_foundry_resource
ANTHROPIC_FOUNDRY_API_KEY=your_foundry_api_key
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-5-2

# ── Retell AI (Voice Outreach) ────────────────
# Get API key: https://dashboard.retellai.com → Settings → API Keys
RETELL_API_KEY=key_your_retell_api_key
# Buy a number in Retell dashboard → Phone Numbers → Buy Number
# Use E.164 format: +1 followed by 10-digit number (e.g. Chicago 312/773)
RETELL_FROM_NUMBER=+13121234567

# ── CRM API Auth (JWT) ────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Comma-separated origins for CORS
CORS_ORIGINS=["http://localhost:5173"]

# ── Recalibration ─────────────────────────────
# Score change threshold to log as significant (0.10 = 10%)
RECALIBRATION_SCORE_CHANGE_THRESHOLD=0.10

# ── NOF Grant Integration ─────────────────────
# Minimum NOF eligibility score to trigger grant-first pitch
NOF_ELIGIBILITY_THRESHOLD=50.0
